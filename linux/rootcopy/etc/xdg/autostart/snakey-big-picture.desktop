[Desktop Entry]
Type=Application
Version=1.0
Name=Snakey Big Picture
Comment=Optional controller-first Snakey console interface
Exec=/bin/sh -c 'test -e "$HOME/.config/snakey/start-big-picture" && exec /usr/bin/snakey-console-session start'
OnlyShowIn=XFCE;
X-XFCE-Autostart-Override=true
Terminal=false
