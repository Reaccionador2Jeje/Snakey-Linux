#!/usr/bin/env bash
set -Eeuo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/snakey"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/snakey"
PID_FILE="$STATE_DIR/big-picture.pid"
AUTOSTART_FILE="$CONFIG_DIR/start-big-picture"
mkdir -p "$STATE_DIR" "$CONFIG_DIR"

is_running() {
  [[ -s "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE")"
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

start() {
  if is_running; then
    echo "Snakey Big Picture is already running (PID $(cat "$PID_FILE"))."
    return 0
  fi
  rm -f "$PID_FILE"
  command -v xfce4-terminal >/dev/null || { echo "xfce4-terminal is required." >&2; exit 2; }
  command -v snakey-big-picture >/dev/null || { echo "snakey-big-picture is not installed." >&2; exit 2; }
  nohup xfce4-terminal --fullscreen --hide-menubar --hide-borders --title=Snakey-Big-Picture --command=/usr/bin/snakey-big-picture >/dev/null 2>&1 &
  echo "$!" > "$PID_FILE"
  echo "Snakey Big Picture started."
}

stop() {
  if ! is_running; then
    rm -f "$PID_FILE"
    echo "Snakey Big Picture is not running."
    return 0
  fi
  local pid
  pid="$(cat "$PID_FILE")"
  kill "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "Snakey Big Picture closed."
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) if is_running; then echo "running (PID $(cat "$PID_FILE"))"; else echo "stopped"; fi ;;
  autostart-on) touch "$AUTOSTART_FILE"; echo "Big Picture will start at the next XFCE login." ;;
  autostart-off) rm -f "$AUTOSTART_FILE"; echo "Automatic Big Picture startup disabled." ;;
  *) echo "Usage: snakey-console-session {start|stop|restart|status|autostart-on|autostart-off}" >&2; exit 2 ;;
esac
