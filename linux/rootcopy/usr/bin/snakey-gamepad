#!/usr/bin/env python3
"""Translate a Linux joystick (/dev/input/js*) into XFCE keyboard navigation."""
from __future__ import annotations
import glob, json, os, shutil, struct, subprocess, sys
from pathlib import Path
from typing import Optional
EVENT = struct.Struct("IhBB")
JS_EVENT_BUTTON, JS_EVENT_AXIS, JS_EVENT_INIT = 0x01, 0x02, 0x80
KEYS = {0: "Return", 1: "Escape", 2: "Tab", 4: "shift+Tab", 5: "Tab", 6: "Return"}
AXIS_KEYS = {0: ("Left", "Right"), 1: ("Up", "Down"), 6: ("Left", "Right"), 7: ("Up", "Down")}
DEADZONE = 16000
DEFAULT_KEYS = dict(KEYS)


def load_profile():
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    path = config_home / "snakey" / "gamepad.json"
    try:
        profile = json.loads(path.read_text())
        keys = {}
        for button, action in profile.get("buttons", {}).items():
            if action != "none":
                keys[int(button)] = action
        return keys, int(profile.get("deadzone", DEADZONE)), int(profile.get("keyboard_button", 3)), profile.get("device", "auto")
    except (OSError, ValueError, TypeError):
        return dict(DEFAULT_KEYS), DEADZONE, 3, "auto"

def key_for_axis(axis: int, value: int) -> Optional[str]:
    if abs(value) < DEADZONE or axis not in AXIS_KEYS:
        return None
    return AXIS_KEYS[axis][1 if value > 0 else 0]

def emit_key(key: str) -> None:
    subprocess.run(["xdotool", "key", "--clearmodifiers", key], check=False)

def open_keyboard() -> None:
    for app in ("onboard", "matchbox-keyboard"):
        executable = shutil.which(app)
        if executable:
            subprocess.Popen([executable], start_new_session=True)
            return
    print("Snakey: install Onboard or Matchbox Keyboard for on-screen typing.", file=sys.stderr)

def find_device() -> Optional[str]:
    configured = os.environ.get("SNAKEY_GAMEPAD_DEVICE")
    if configured and os.path.exists(configured):
        return configured
    devices = sorted(glob.glob("/dev/input/js*"))
    return devices[0] if devices else None

def main() -> int:
    if not shutil.which("xdotool"):
        print("Snakey Gamepad: xdotool is required.", file=sys.stderr)
        return 2
    keys, deadzone, keyboard_button, configured_device = load_profile()\n    print("Snakey Gamepad: waiting for a controller...")
    while True:
        device = find_device(configured_device)
        if not device:
            import time
            time.sleep(2)
            continue
        print(f"Snakey Gamepad: reading {device}")
        last_axis: dict[int, Optional[str]] = {}
        try:
            with open(device, "rb", buffering=0) as joystick:
                while True:
                    raw = joystick.read(EVENT.size)
                    if len(raw) != EVENT.size:
                        break
                    _time, value, event_type, number = EVENT.unpack(raw)
                    event_type &= ~JS_EVENT_INIT
                    if event_type == JS_EVENT_BUTTON and value:
                        if number == 3:
                            open_keyboard()
                        elif number in KEYS:
                            emit_key(KEYS[number])
                    elif event_type == JS_EVENT_AXIS and number in AXIS_KEYS:
                        key = key_for_axis(number, value, deadzone)
                        if key and last_axis.get(number) != key:
                            emit_key(key)
                        last_axis[number] = key
        except PermissionError:
            print(f"Snakey Gamepad: permission denied for {device}; check input-group access.", file=sys.stderr)
            return 2
        except FileNotFoundError:
            continue
        except KeyboardInterrupt:
            return 0

if __name__ == "__main__":
    raise SystemExit(main())
