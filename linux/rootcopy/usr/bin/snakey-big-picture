#!/usr/bin/env python3
"""Snakey Console Desktop launcher for XFCE4 and controller-first sessions."""
from __future__ import annotations

import curses
import glob
import json
import os
import select
import shutil
import struct
import subprocess
from pathlib import Path
from typing import Optional

JS_EVENT = struct.Struct("IhBB")
JS_EVENT_BUTTON = 0x01
JS_EVENT_AXIS = 0x02
JS_EVENT_INIT = 0x80
DEADZONE = 16000
CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "snakey" / "gamepad.json"

ITEMS = (
    ("Games", ("retroarch",), "Launch RetroArch"),
    ("Applications", ("xfce4-appfinder",), "Browse installed applications"),
    ("Files", ("thunar",), "Open the file manager"),
    ("Terminal", ("xfce4-terminal",), "Open a terminal"),
    ("Controller Center", ("snakey-controller-center",), "Configure your gamepad"),
    ("Settings", ("xfce4-settings-manager",), "Configure Snakey Linux"),
    ("Desktop Mode", ("snakey-console-mode", "off"), "Restore standard XFCE4 panel sizing"),
    ("Power", ("xfce4-session-logout",), "Log out or shut down"),
)

DEFAULT_PROFILE = {
    "device": "auto",
    "deadzone": DEADZONE,
    "buttons": {"0": "Return", "1": "Escape", "2": "Tab", "4": "shift+Tab", "5": "Tab", "6": "Return"},
}


def load_profile(path: Path = CONFIG_PATH) -> dict:
    """Load the shared Controller Center profile with safe defaults."""
    profile = {
        "device": DEFAULT_PROFILE["device"],
        "deadzone": DEFAULT_PROFILE["deadzone"],
        "buttons": dict(DEFAULT_PROFILE["buttons"]),
    }
    try:
        saved = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(saved, dict):
            profile["device"] = str(saved.get("device", profile["device"]))
            profile["deadzone"] = max(1000, min(32000, int(saved.get("deadzone", profile["deadzone"]))))
            if isinstance(saved.get("buttons"), dict):
                profile["buttons"].update({str(k): str(v) for k, v in saved["buttons"].items()})
    except (OSError, ValueError, TypeError):
        pass
    return profile


def find_gamepad(configured: str = "auto") -> Optional[str]:
    environment_device = os.environ.get("SNAKEY_GAMEPAD_DEVICE")
    selected = environment_device or configured
    if selected != "auto" and os.path.exists(selected):
        return selected
    devices = sorted(glob.glob("/dev/input/js*"))
    return devices[0] if devices else None


def decode_gamepad_event(
    raw: bytes,
    selected: int,
    count: int,
    buttons: Optional[dict[str, str]] = None,
    deadzone: int = DEADZONE,
) -> tuple[int, str | None]:
    """Translate configured Linux joystick events into launcher actions."""
    if len(raw) != JS_EVENT.size:
        return selected, None
    _timestamp, value, event_type, number = JS_EVENT.unpack(raw)
    event_type &= ~JS_EVENT_INIT
    if event_type == JS_EVENT_BUTTON and value:
        mapping = buttons if buttons is not None else DEFAULT_PROFILE["buttons"]
        action = mapping.get(str(number), "none").lower().replace(" ", "")
        if action in ("return", "enter", "space"):
            return selected, "confirm"
        if action in ("escape", "esc"):
            return selected, "back"
        if action == "tab":
            return (selected + 1) % count, None
        if action in ("shift+tab", "shift-tab"):
            return (selected - 1) % count, None
    if event_type == JS_EVENT_AXIS and abs(value) > deadzone:
        if number == 1:
            return (selected + (1 if value > 0 else -1)) % count, None
        if number == 0:
            return selected, "confirm" if value > 0 else "back"
    return selected, None


def launch(command: tuple[str, ...], stdscr) -> bool:
    executable = command[0]
    if not shutil.which(executable):
        message(stdscr, f"Not installed: {executable}")
        return False
    curses.def_prog_mode()
    curses.endwin()
    try:
        subprocess.run(command, check=False)
    except OSError as exc:
        print(f"Snakey: could not launch {executable}: {exc}")
        input("Press Enter to return to Snakey...")
    curses.reset_prog_mode()
    stdscr.clear()
    stdscr.refresh()
    return True


def message(stdscr, text: str) -> None:
    height, width = stdscr.getmaxyx()
    stdscr.addnstr(max(0, height - 2), 2, text, max(1, width - 4), curses.A_BOLD)
    stdscr.refresh()
    stdscr.timeout(-1)
    stdscr.getch()
    stdscr.timeout(50)


def draw(stdscr) -> int:
    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.timeout(50)
    selected = 0
    profile = load_profile()
    device_path = find_gamepad(profile["device"])
    gamepad = None
    if device_path:
        try:
            gamepad = open(device_path, "rb", buffering=0)
        except OSError:
            gamepad = None
    poller = select.poll()
    if gamepad:
        poller.register(gamepad, select.POLLIN | select.POLLHUP | select.POLLERR)

    try:
        while True:
            stdscr.erase()
            height, width = stdscr.getmaxyx()
            title = "SNAKEY"
            subtitle = "CONSOLE DESKTOP"
            stdscr.attron(curses.A_BOLD)
            stdscr.addnstr(1, max(1, (width - len(title)) // 2), title, max(1, width - 2))
            stdscr.attroff(curses.A_BOLD)
            stdscr.addnstr(2, max(1, (width - len(subtitle)) // 2), subtitle, max(1, width - 2))
            stdscr.addnstr(4, 3, "XFCE4 • Slackware • Controller-first interface", max(1, width - 6))
            start_y = 6
            visible = max(1, (height - 10) // 2)
            first = min(max(0, selected - visible + 1), max(0, len(ITEMS) - visible))
            for index in range(first, min(len(ITEMS), first + visible)):
                y = start_y + (index - first) * 2
                label, _command, description = ITEMS[index]
                attr = curses.A_REVERSE | curses.A_BOLD if index == selected else curses.A_NORMAL
                stdscr.addnstr(y, 4, f"  {label}  ", max(1, width - 8), attr)
                if y + 1 < height - 3:
                    stdscr.addnstr(y + 1, 7, description, max(1, width - 12), curses.A_DIM)
            status = f"Controller: {device_path}" if gamepad else "Controller not detected • keyboard available"
            stdscr.addnstr(height - 3, 2, status, max(1, width - 4), curses.A_DIM)
            stdscr.addnstr(height - 2, 2, "A / ENTER: open   B / ESC: back   D-pad / arrows: move   Q: exit", max(1, width - 4), curses.A_DIM)
            stdscr.refresh()

            if gamepad:
                for _fd, event in poller.poll(0):
                    if event & (select.POLLHUP | select.POLLERR):
                        poller.unregister(gamepad)
                        gamepad.close()
                        gamepad = None
                        device_path = None
                        break
                    try:
                        raw = os.read(gamepad.fileno(), JS_EVENT.size)
                    except OSError:
                        raw = b""
                    selected, action = decode_gamepad_event(
                        raw, selected, len(ITEMS), profile["buttons"], profile["deadzone"]
                    )
                    if action == "back":
                        return 0
                    if action == "confirm":
                        launch(ITEMS[selected][1], stdscr)

            key = stdscr.getch()
            if key in (curses.KEY_UP, ord("w"), ord("k")):
                selected = (selected - 1) % len(ITEMS)
            elif key in (curses.KEY_DOWN, ord("s"), ord("j")):
                selected = (selected + 1) % len(ITEMS)
            elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
                launch(ITEMS[selected][1], stdscr)
            elif key in (27, ord("q"), ord("Q")):
                return 0
            elif key == curses.KEY_RESIZE:
                stdscr.clear()
    finally:
        if gamepad:
            gamepad.close()


def main() -> int:
    try:
        return curses.wrapper(draw)
    except (KeyboardInterrupt, curses.error):
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
