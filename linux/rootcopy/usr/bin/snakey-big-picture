#!/usr/bin/env python3
"""Controller-first, fullscreen-friendly launcher for Snakey Linux XFCE."""
import curses
import shutil
import subprocess

ITEMS = [
    ("Games", "retroarch", "Launch RetroArch"),
    ("Applications", "xfce4-appfinder", "Browse installed applications"),
    ("Files", "thunar", "Open the file manager"),
    ("Terminal", "xfce4-terminal", "Open a terminal"),
    ("Controller Center", "snakey-controller-center", "Configure and test your gamepad"),
    ("Settings", "xfce4-settings-manager", "Configure Snakey Linux"),
    ("Desktop / Console Mode", "snakey-console-mode", "Toggle large-control desktop mode"),
]

def launch(command, stdscr):
    executable = command[0]
    if not shutil.which(executable):
        stdscr.addstr(curses.LINES - 2, 2, f"Not installed: {executable}"[:curses.COLS - 4])
        stdscr.refresh()
        stdscr.getch()
        return
    curses.endwin()
    try:
        subprocess.Popen(command, start_new_session=True)
    except OSError as exc:
        print(f"Snakey Big Picture: {exc}")
        input("Press Enter to return...")
    raise SystemExit(0)

def draw(stdscr):
    curses.curs_set(0)
    selected = 0
    while True:
        stdscr.erase()
        height, width = stdscr.getmaxyx()
        title = "SNAKEY"
        subtitle = "BIG PICTURE"
        stdscr.attron(curses.A_BOLD)
        stdscr.addstr(1, max(2, (width - len(title)) // 2), title)
        stdscr.attroff(curses.A_BOLD)
        stdscr.addstr(2, max(2, (width - len(subtitle)) // 2), subtitle)
        stdscr.addstr(4, 3, "Navigate with your controller or keyboard")
        start_y = 6
        for index, (label, _command, description) in enumerate(ITEMS):
            y = start_y + index * 2
            if y >= height - 3:
                break
            attr = curses.A_REVERSE | curses.A_BOLD if index == selected else curses.A_NORMAL
            stdscr.addnstr(y, 4, f"  {label}  ", max(1, width - 8), attr)
            stdscr.addnstr(y + 1, 7, description, max(1, width - 12), curses.A_DIM)
        footer = "A / ENTER: open     B / ESC: exit     UP / DOWN: navigate"
        stdscr.addnstr(height - 2, 2, footer, max(1, width - 4), curses.A_DIM)
        stdscr.refresh()
        key = stdscr.getch()
        if key in (curses.KEY_UP, ord("w"), ord("k")):
            selected = (selected - 1) % len(ITEMS)
        elif key in (curses.KEY_DOWN, ord("s"), ord("j")):
            selected = (selected + 1) % len(ITEMS)
        elif key in (10, 13, curses.KEY_ENTER, ord(" ")):
            label, command, _description = ITEMS[selected]
            if label == "Desktop / Console Mode":
                curses.endwin()
                subprocess.run([command, "toggle"], check=False)
                raise SystemExit(0)
            launch([command], stdscr)
        elif key in (27, ord("q"), ord("Q")):
            return

def main():
    try:
        curses.wrapper(draw)
    except (KeyboardInterrupt, curses.error):
        return 1
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
